<https://w3id.org/FAIR-course-UT/2026/group28/dataset/coteq-electricity-2013>
    a dcat:Dataset ;
    dct:identifier "https://w3id.org/FAIR-course-UT/2026/group28/data"^^xsd:anyURI ;
    dct:isVersionOf <https://w3id.org/FAIR-course-UT/2026/group28/data/original> ;
    dct:title "Dutch Electricity Consumption Dataset - Coteq Netbeheer (2013)"@en ;
    dct:description "Tabular electricity consumption records collected by regional network manager Coteq Netbeheer B.V. for 2013 across municipalities in Overijssel, Netherlands. Transformed from raw CSV into RDF (Turtle) using OpenRefine according to the Dutch Electricity Ontology, comprising 2,503 energy records and 46,236 triples."@en ;
    dcat:keyword "electricity"@en , "energy consumption"@en , "smart meters"@en , "network operator"@en , "Coteq"@en , "Netbeheer"@nl ;
    dct:issued "2026-10-24"^^xsd:date ;
    dct:creator [ a foaf:Person ; foaf:name "Varsha" ] ,
    dct:creator [ a foaf:Person ; foaf:name "Joshita" ] ;
    dct:publisher <https://www.kaggle.com/datasets/lucabasa/dutch-energy> ;
    dcat:landingPage <https://github.com/varshavasaraju/Dutch-Electricity-Fair-Data/tree/main/Dutch_Electricity_fair_project> ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dct:rights "Publicly accessible without authentication. The original CSV is provided under an unknown licence; reuse requires verification of the source licence."@en ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dct:source <https://www.kaggle.com/datasets/lucabasa/dutch-energy> ;
    prov:wasDerivedFrom <https://www.kaggle.com/datasets/lucabasa/dutch-energy> ;
    dct:conformsTo <https://w3id.org/FAIR-course-UT/2026/group28/dutch-energy-ontology> ;
    prov:wasAttributedTo [ a prov:Agent ; foaf:name "Varsha" ] ,
    prov:wasAttributedTo [ a prov:Agent ; foaf:name "Joshita" ] ;
    prov:generatedAtTime "2026-10-24T12:00:00Z"^^xsd:dateTime ;
    ont:observationType "Energy Consumption Record" ;
    schema:variableMeasured "connection count", "active connections %", "delivery %", "low‑tariff consumption %", "smart meter %", "annual consumption (kWh)", "municipality", "street" ;
    dcat:distribution
        <https://w3id.org/FAIR-course-UT/2026/group28/distribution/coteq-electricity-2013-csv> ,
        <https://w3id.org/FAIR-course-UT/2026/group28/distribution/coteq-electricity-2013-rdf> .

